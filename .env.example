# dsh-ssh-hub 环境变量示例（可选，均有默认值）
# 密钥库目录（默认 ~/.ssh/dsh-ssh-hub）
DSH_SSH_HUB_DIR=~/.ssh/dsh-ssh-hub
# 同步目标 SSH 目录（默认 ~/.ssh）
DSH_SSH_DIR=~/.ssh
# 服务器密码（用于 ssh-hub add --password / password set，
# 优先级高于 --password 命令行参数，避免密码出现在 ps aux / shell history 中）
# DSH_SSH_PASSWORD=
# 备份加密密码（用于 ssh-hub backup --encrypt，避免密码出现在 ps aux 中）
# DSH_SSH_BACKUP_PASSWORD=
